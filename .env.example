# =============================================================================
# Job Application Preprocessor - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# Storage
# =============================================================================
# Job data is stored in a local SQLite database at ./local_data/jobs.db
# Use the Streamlit dashboard (streamlit run dashboard.py) to view and manage jobs.

# =============================================================================
# LinkedIn Configuration
# =============================================================================
# Your LinkedIn email address for authentication
EMAIL_ADDRESS=your_email@example.com

# Enable LinkedIn crawling/scraping (set to "true" to enable)
# Default: false
CRAWL_LINKEDIN=false

# Your LinkedIn password, needed only if CRAWL_LINKEDIN=true
LINKEDIN_PASSWORD=your_password

# =============================================================================
# Apify Configuration
# =============================================================================
# Your Apify API token for LinkedIn job scraping
# Get it from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# =============================================================================
# API Server Configuration
# =============================================================================
# URL of the API server for job analysis and resume/cover letter generation
SERVER_URL=https://your-api-server.com

# API key/secret for authenticating with the server
API_KEY=your_api_secret_key_here

# =============================================================================
# Google Gemini API Configuration
# =============================================================================
# Primary Gemini API key for LLM operations
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backup Gemini API key (optional, used if primary hits rate limits)
BACKUP_GEMINI_API_KEY=your_backup_gemini_api_key_here

# Gemini model to use for analysis and generation
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-3.0-flash

# =============================================================================
# Personalization
# =============================================================================
# Path to your resume in PDF format.
# If resume_data.json is missing, the app will try to generate it using this PDF.
RESUME_PDF_PATH=path/to/your/resume.pdf

# =============================================================================
# Feature Flags
# =============================================================================
# Enable sustainability checking for companies (set to "true" to enable)
# Default: false
CHECK_SUSTAINABILITY=false

