# =============================================================================
# Job Filtering & Personalization Configuration
# =============================================================================
# This file allows you to customize which jobs are skipped, how they are prioritized,
# and what criteria are used for sustainability analysis.

# -----------------------------------------------------------------------------
# Keyword-based Filtering (Negative Filters)
# -----------------------------------------------------------------------------
# Jobs matching these keywords will be marked as "Poor fit" or "Very poor fit"
# and will NOT be processed further (saving LLM and Apify costs).

# Exact substrings found anywhere in the job title (case-insensitive)
job_title_skip_keywords:
  - example_unwanted_skill_1
  - example_unwanted_skill_2
  - manager

# Whole words found in the job title (useful for short acronyms like SAP)
job_title_skip_keywords_2:
  - example_unwanted_skill_3

# Keywords found in the company name (case-insensitive)
company_skip_keywords:
  - example_unwanted_company

# Keywords found in the location string (case-insensitive)
location_skip_keywords:
  - example_location_1
  - example_location_2

# -----------------------------------------------------------------------------
# Keyword-based Targeting (Positive Filters)
# -----------------------------------------------------------------------------
# Opt-in "require" filters. Leave the lists empty (the default) to disable them
# and keep the previous behavior. When a list is non-empty, a job is kept only if
# it matches at least one of its keywords (case-insensitive substring match).
# Skip keywords above always win: a job matching a skip keyword is dropped even
# if it also matches a require keyword.

# Keep a job only if its TITLE contains one of these (case-insensitive substring)
job_title_require_keywords: []
#   - python
#   - backend

# Keep a job only if its TITLE or DESCRIPTION contains one of these
job_require_keywords: []
#   - kubernetes
#   - postgres

# -----------------------------------------------------------------------------
# Location Priorities (Positive Filters)
# -----------------------------------------------------------------------------
# Lower numbers = higher priority (e.g., 1 is top priority).
# Jobs matching these locations will be sorted to the top of the list.
# This section is optional. If empty or missing, all locations have equal priority.
location_priorities:
  remote: 1
  your_city: 1
  your_country: 2

# Auto-adjust: when at least good_fit_threshold jobs are "Good fit" or "Very good fit",
# their top locations are added to location_priorities. Set enabled: false to turn off.
# You can revert the last adjustment in Dashboard → Settings.
# auto_filter_adjustment:
#   enabled: false
#   good_fit_threshold: 5

# -----------------------------------------------------------------------------
# Sustainability Criteria (Optional)
# -----------------------------------------------------------------------------
# Used for keyword-based filtering (negative = skip job) and, when
# CHECK_SUSTAINABILITY=true, for the LLM sustainability check.
# Positive/negative are substring-matched (case-insensitive) in title, company,
# location, and optionally company overview (see use_company_overview below).
sustainability_criteria:
  positive:
    - Renewable energy, clean tech, environmental protection
    - Healthcare, medical research, medical devices
    - Education, academic institutions, learning platforms
  negative:
    - Weapons, arms, defense contractors, military equipment
    - Fossil fuels, oil & gas, petroleum, coal
    - Tobacco, cigarettes, vaping products
    - Gambling, casinos, betting
    - Predatory lending, payday loans
    - Harmful addictions or exploitative industries
  # When true, negative/positive keyword check also uses Company overview text.
  use_company_overview_for_sustainability_keywords: true

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
general_settings:
  # The theme used for generating the tailored resume PDF.
  # Options depend on what the CV rendering server supports (e.g., engineeringclassic)
  resume_theme: engineeringclassic

# -----------------------------------------------------------------------------
# LLM prompt overrides (optional)
# -----------------------------------------------------------------------------
# Leave empty to use built-in defaults. Edit in Dashboard → Settings → Prompts,
# or paste overrides under named keys (fit_score_batch, jd_fit, search_parameters,
# bulk_filter, sustainability_bulk, sustainability_single, salary_fit, etc.).
# prompts: {}
